# Port cho ứng dụng Web
PORT=3000

# Địa chỉ IP hoặc Hostname của card iLO 4
ILO_HOST=192.168.1.100
ILO_SSH_PORT=22
ILO_HTTP_PORT=443

# Tài khoản quản trị iLO (cần quyền SSH & xem thông tin Thermal)
ILO_USERNAME=Administrator
ILO_PASSWORD=your_ilo_password

# Giới hạn tốc độ quạt tối thiểu an toàn (%)
MINIMUM_FAN_SPEED=15

# Đặt true nếu muốn chạy chế độ giả lập test UI, false để kết nối máy chủ thật
MOCK_MODE=false
